{
  "name": "thailand-humanoid-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev",
    "dev:casebook": "tsx scripts/dev-casebook.ts",
    "seed:watch": "tsx scripts/watch-seed.ts",
    "build": "node scripts/generate-prisma.mjs && next build",
    "vercel-build": "node scripts/generate-prisma.mjs && next build",
    "postinstall": "node scripts/generate-prisma.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:no-mock-data": "tsx scripts/assert-no-mock-data.ts",
    "seo:audit": "tsx scripts/seo-optimizer.ts --dry-run",
    "seo:optimize": "tsx scripts/seo-optimizer.ts --apply",
    "network:check": "node --import tsx scratch/check-network-sources.mjs",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:wellness": "tsx scripts/seed-wellness.ts",
    "ingest:openalex": "tsx scripts/ingest.ts openalex",
    "ingest:github": "tsx scripts/ingest.ts github",
    "ingest:gdelt": "tsx scripts/ingest.ts gdelt",
    "ingest:youtube": "tsx scripts/ingest.ts youtube",
    "test": "tsx --test test/*.test.ts",
    "test:casebook": "tsx scripts/test-casebook.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "bpmn-js": "^18.19.0",
    "cytoscape": "^3.34.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.1",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@electric-sql/pglite-socket": "0.1.6",
    "@playwright/test": "^1.61.1",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.61.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
